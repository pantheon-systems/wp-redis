# WordPress site credentials
WP_URL=https://<env>-<site>.pantheonsite.io
WP_USER=pantheon
WP_PASSWORD=

# Browser settings
HEADLESS=true
SLOW_MO=0

# Allowlisted CI User-Agent. Only needed if the environment is fronted by a
# bot-challenge (e.g. Cloudflare) that blocks the default headless User-Agent.
CI_UA=
